# Cirvix — secret protection
#
# The rules that make a credential unreachable rather than merely discouraged.
#
# The threat model is not a malicious developer. It is a model that read a web
# page, a GitHub issue, or a README containing an instruction addressed to it,
# and is now sincerely trying to help by fetching a credential and posting it
# somewhere. Every rule here assumes the agent has already been persuaded.
#
# THE TWO RULES THAT MATTER MOST are the egress pair at the bottom. Blocking
# credential reads is the obvious half; blocking the *outbound call that carries
# one* is what closes the loop when a credential arrives by a route nobody
# anticipated.
#
#   cirvix policy test --policy policies/secrets.policy

# --------------------------------------------------------------- reading them

deny:
  name = deny-dotenv
  tool = filesystem.read
  path = **/.env
  reason = "Reading .env is the shortest path from a prompt injection to a live credential."
  remediation = "Request the value as a handle: secrets.get(\"NAME\")"

deny:
  name = deny-dotenv-variants
  tool = filesystem.read
  path = **/.env.*
  reason = ".env.production and friends hold the credentials that matter most."

deny:
  name = deny-aws
  tool = filesystem.read
  path = **/.aws/**
  reason = "Cloud credentials are never readable by an agent."

deny:
  name = deny-ssh
  tool = filesystem.read
  path = **/.ssh/**
  reason = "An SSH private key is authentication to every host that trusts it."

deny:
  name = deny-gnupg
  tool = filesystem.read
  path = **/.gnupg/**
  reason = "GPG private keys sign releases and decrypt archives."

deny:
  name = deny-kube-config
  tool = filesystem.read
  path = **/.kube/config
  reason = "A kubeconfig is cluster-admin to whatever it points at."

deny:
  name = deny-npmrc
  tool = filesystem.read
  path = **/.npmrc
  reason = "An npm token can publish a package the whole company installs."

deny:
  name = deny-netrc
  tool = filesystem.read
  path = **/.netrc
  reason = ".netrc holds plaintext credentials for every host it lists."

deny:
  name = deny-docker-config
  tool = filesystem.read
  path = **/.docker/config.json
  reason = "Registry credentials let an attacker publish an image your cluster pulls."

deny:
  name = deny-private-keys
  tool = filesystem.read
  path = **/*.pem
  reason = "PEM files are private keys or the certificates that depend on them."

deny:
  name = deny-pkcs12
  tool = filesystem.read
  path = **/*.p12
  reason = "A PKCS#12 bundle contains a private key."

deny:
  name = deny-service-account-json
  tool = filesystem.read
  path = **/service-account*.json
  reason = "A GCP service-account key is a non-expiring credential."

deny:
  name = deny-terraform-state
  tool = filesystem.read
  path = **/terraform.tfstate
  reason = "Terraform state routinely contains provisioned secrets in plaintext."

deny:
  name = deny-git-credentials
  tool = filesystem.read
  path = **/.git-credentials
  reason = "Stored git credentials are plaintext by design."

# --------------------------------------------------------------- copying them

deny:
  name = deny-shell-cat-credentials
  tool = shell.exec
  command = ".aws/credentials"
  reason = "Reading a credential through a shell is the same read with an extra step."

deny:
  name = deny-shell-env-dump
  tool = shell.exec
  command = "printenv"
  reason = "Dumping the environment puts every credential in the process into the model's context."

deny:
  name = deny-shell-ssh-key
  tool = shell.exec
  command = "id_rsa"
  reason = "Reading a private key through a shell is the same read with an extra step."

# ---------------------------------------------------------------- moving them
#
# The pair that closes the loop. An agent may reach the network; it may not put
# a credential in the request, and once it has touched credential material it
# does not reach the network at all for the rest of the session.

deny:
  name = deny-egress-carrying-secrets
  tool = network.request
  secrets >= 1
  reason = "This request carries credential material. Send a scoped handle instead — the broker substitutes it on the wire and the value never enters the model's context."
  remediation = "secrets.get(\"NAME\") returns a handle. Pass the handle where you would have passed the key."

deny:
  name = deny-egress-after-secret-read
  tool = network.request
  touched_secret = true
  reason = "This session read secret-shaped material, so outbound requests are blocked for the remainder of it."

deny:
  name = deny-cloud-metadata-ip
  network.destination = 169.254.169.254
  reason = "The cloud instance-metadata endpoint returns live role credentials to anything that can reach it."

deny:
  name = deny-cloud-metadata-hostname
  network.destination = metadata.google.internal
  reason = "Cloud metadata by hostname resolves to the same link-local address."

deny:
  name = deny-alibaba-metadata
  network.destination = 100.100.100.200
  reason = "The same instance-metadata attack, on another provider."

deny:
  name = deny-ecs-task-metadata
  network.destination = 169.254.170.2
  reason = "ECS task metadata returns the task role's credentials."

# ------------------------------------------------------------------ sanitize

sanitize:
  name = sanitize-outbound-arguments
  tool = network.request
  targets = arguments
  reason = "Strip any credential material the model interpolated into a request before it goes on the wire."

# ------------------------------------------------------------------ test cases

test "dotenv":
  tool = filesystem.read
  path = .env
  expect deny

test "production dotenv":
  tool = filesystem.read
  path = .env.production
  expect deny

test "aws credentials by tilde":
  tool = filesystem.read
  path = ~/.aws/credentials
  expect deny

test "ssh private key":
  tool = filesystem.read
  path = ~/.ssh/id_rsa
  expect deny

test "cloud metadata":
  tool = network.request
  url = http://169.254.169.254/latest/meta-data/iam/security-credentials/
  expect deny

test "gcp metadata by hostname":
  tool = network.request
  url = http://metadata.google.internal/computeMetadata/v1/
  expect deny

test "reading a credential through a shell":
  tool = shell.exec
  command = cat ~/.aws/credentials
  expect deny

test "dumping the environment":
  tool = shell.exec
  command = printenv
  expect deny

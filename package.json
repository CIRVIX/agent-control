{
  "name": "cirvix",
  "version": "0.3.0",
  "private": true,
  "description": "Runtime policy enforcement for AI agent tool calls. Apache 2.0 engine, zero runtime dependencies.",
  "license": "Apache-2.0",
  "homepage": "https://cirvix.com/",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cirvix/agent-control.git"
  },
  "bugs": {
    "url": "https://github.com/cirvix/agent-control/issues"
  },
  "workspaces": [
    "packages/agent-control"
  ],
  "scripts": {
    "test": "npm test --workspace @cirvix_ai/agent-control",
    "verify:adversarial": "npm run verify:adversarial --workspace @cirvix_ai/agent-control",
    "verify:version": "node tools/check-version.mjs",
    "verify:public": "node tools/audit-public-repo.mjs --self-test && node tools/audit-public-repo.mjs",
    "verify:license": "node tools/check-license.mjs",
    "verify:package": "node tools/verify-package.mjs",
    "proof-suite": "node tools/proof-suite.mjs",
    "demos": "node tools/commercial-demos.mjs",
    "demo": "node demo/live.mjs all",
    "demo:setup": "node demo/live.mjs setup",
    "demo:reset": "node demo/live.mjs reset",
    "demo:step": "node demo/live.mjs",
    "demo:scenarios": "node demo/scenarios.mjs all",
    "demo:a": "node demo/scenarios.mjs A",
    "demo:b": "node demo/scenarios.mjs B",
    "demo:c": "node demo/scenarios.mjs C",
    "bench": "node benchmarks/decision.mjs",
    "bench:system": "node benchmarks/system.mjs",
    "example": "node docs/examples/pr-title-injection.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "puppeteer": "^25.13.0",
    "typescript": "7.0.2"
  }
}
